{# Shared site header. Included by page.html.twig, page--front.html.twig, page--node--detail-page.html.twig. #}
<header>
    <div class="container header-top">
        {{ page.logo }}

        <div class="menus only-desk">
            {{ page.primary_menu }}

        </div>
    </div>

    <div class="mobile-bottom-header only-mob">
        <a href="/"><img src="/themes/custom/nws/assets/images/home.svg" alt="" aria-label="Home"></a>
        <a href="/search" class="search"><img src="/themes/custom/nws/assets/images/search.svg" alt="" aria-label="Search"></a>
        <a href="/contact"><img src="/themes/custom/nws/assets/images/email.svg" alt="" aria-label="Contact us"></a>
        <div class="only-mob menu-open mobile-menu">
            <img src="/themes/custom/nws/assets/images/humberger.svg" alt="" class="open">
            <img src="/themes/custom/nws/assets/images/close.svg" alt="" class="close">
        </div>
        {{ page.search }}
    </div>

    <div class="bottom-header">
        <div class="container">
            {{ page.secondary_menu }}
        </div>
    </div>
</header>
